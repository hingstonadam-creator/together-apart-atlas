  "narrative": {
    "northStar": "Exhibition catalogue",
    "overview": "Together, Apart. is presented as an exhibition catalogue: spacious, visual and presentation-led. Architectural drawings and supplied project images carry the work; clear typography, warm surfaces and fine rules organise its reading.\n\nControls are restrained and precise. Square edges, fine borders and explicit interaction states give the site a consistent frame. Depth is lightly layered where separation is useful, with the existing research preview providing the model for a subtle contextual shadow.",
    "keyCharacteristics": [
      "Spacious compositions with a clear reading hierarchy.",
      "Clay, ivory and ink, with separate colours for recorded research relationships.",
      "Square panels and controls, fine rules and visible keyboard focus.",
      "Supplied drawings kept legible, proportional and available at full size."
    ],
    "rules": [
      {
        "name": "Drawing Integrity",
        "body": "Preserve the complete proportions, annotations and colours of supplied drawings. Use a plain labelled slot until artwork is supplied.",
        "section": "colors"
      },
      {
        "name": "Selective Layering",
        "body": "Keep ordinary controls and content panels flat. Reserve subtle shadows for contextual elements that need separation from the content beneath.",
        "section": "elevation"
      },
      {
        "name": "Visible Choice",
        "body": "Pair colour with text, an underline, a border or a pressed state. Keep active filters visible and removable.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do lead with supplied project imagery and a clear hierarchy.",
      "Do keep clay for actions and emphasis, ivory for the ground, and ink for reading.",
      "Do preserve square controls, fine rules and visible focus.",
      "Do retain both matching research results and the complete source register.",
      "Do check narrow layouts against long labels and real findings."
    ],
    "donts": [
      "Don't generate substitute drawings or publish placeholder-instruction images.",
      "Don't use shadows on every panel or introduce rounded cards as the default.",
      "Don't communicate selection through colour alone.",
      "Don't make a graph the only route to reading research.",
      "Don't treat older unused CSS or atlas.js as the active Research implementation."
    ]
  }
}
